
/* ========================================
   1. CSS VARIABLES
   ======================================== */

:root {
    --cream: #F8F6F0;
    --white: #FFFFFF;

    --sage: #8FA58B;
    --sage-dark: #617B60;
    --sage-light: #E8EFE5;

    --text: #30382F;
    --muted: #899087;

    --border: #ECEDE6;

    --peach: #F6E5D8;
    --lavender: #ECE8F6;

    --shadow: 0 5px 24px rgba(54, 69, 51, 0.05);

    --sidebar-width: 250px;
}


/* ========================================
   2. GLOBAL RESET
   ======================================== */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background-color: var(--cream);
    color: var(--text);
    font-size: 15px;
    line-height: 1.6;
}

button,
input,
select,
textarea {
    font: inherit;
}

button {
    cursor: pointer;
}

button:focus-visible,
a:focus-visible,
input:focus-visible {
    outline: 2px solid var(--sage-dark);
    outline-offset: 3px;
}

a {
    color: inherit;
    text-decoration: none;
}

img {
    max-width: 100%;
    display: block;
}


/* ========================================
   3. MAIN APP LAYOUT
   ======================================== */

.app-container {
    min-height: 100vh;
}

.main-content {
    margin-left: var(--sidebar-width);
    padding: 36px;
    min-height: 100vh;
}


/* ========================================
   4. SIDEBAR
   ======================================== */

.sidebar {
    width: var(--sidebar-width);
    height: 100vh;

    position: fixed;
    top: 0;
    left: 0;

    display: flex;
    flex-direction: column;

    padding: 30px 20px;

    background-color: var(--white);
    border-right: 1px solid var(--border);

    overflow-y: auto;
    z-index: 100;
}


/* ========================================
   5. BRAND AND LOGO
   ======================================== */


.brand {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 40px;
}

.brand-logo {
    width: 42px;
    height: 42px;
    object-fit: contain;
    flex-shrink: 0;
}

.brand-name {
    font-size: 24px;
    font-weight: 700;
    color: var(--sage-dark);
    letter-spacing: -0.8px;
}



/* ========================================
   6. SIDEBAR NAVIGATION
   ======================================== */

.sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.nav-heading {
    margin: 0 0 12px 10px;

    color: var(--muted);
    font-size: 11px;
    font-weight: 700;

    letter-spacing: 1.5px;
    text-transform: uppercase;
}

.nav-link {
    display: flex;
    align-items: center;
    gap: 12px;

    padding: 12px 14px;

    color: var(--muted);
    border-radius: 12px;

    font-size: 14px;
    font-weight: 500;

    transition: /**/
        background-color 0.2s ease,
        color 0.2s ease,
        transform 0.2s ease;
}

.nav-link:hover {
    color: var(--sage-dark);
    background-color: var(--sage-light);
}

.nav-link:active {
    transform: scale(0.98);
}

.nav-link.active {
    color: var(--sage-dark);
    background-color: var(--sage-light);
    font-weight: 700;
}

.nav-icon {
    width: 22px;
    text-align: center;
    font-size: 18px;
}


/* ========================================
   7. MOTIVATION CARD
   ======================================== */

.motivation-card {
    margin-top: auto;
    margin-bottom: 24px;

    padding: 20px;

    background-color: var(--sage-light);
    border-radius: 18px;
}

.motivation-icon {
    font-size: 25px;
    margin-bottom: 10px;
}

.motivation-card h3 {
    margin-bottom: 8px;

    color: var(--sage-dark);
    font-size: 15px;
    font-weight: 700;
}

.motivation-card p {
    color: var(--muted);
    font-size: 12px;
    line-height: 1.7;
}


/* ========================================
   8. PROFILE SECTION
   ======================================== */

.profile {
    display: flex;
    align-items: center;
    gap: 12px;

    padding-top: 20px;
    border-top: 1px solid var(--border);
}

.profile-avatar {
    width: 42px;
    height: 42px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;
    background-color: var(--peach);

    font-size: 18px;
    flex-shrink: 0;
}

.profile-info {
    flex: 1;
    min-width: 0;
}

.profile-info h4 {
    color: var(--text);
    font-size: 13px;
    font-weight: 700;
}

.profile-info p {
    color: var(--muted);
    font-size: 11px;
}

.profile-menu {
    color: var(--muted);
    font-size: 20px;
    cursor: pointer;
}


/* ========================================
   9. TOP HEADER
   ======================================== */

.top-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;

    margin-bottom: 32px;
}

.top-header h1 {
    color: var(--text);
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -1px;
    line-height: 1.3;
}

.top-header p {
    margin-top: 6px;
    color: var(--muted);
    font-size: 14px;
}

#currentDate {
    margin-top: 8px;
    color: var(--muted);
    font-size: 13px;
}


/* ========================================
   10. BUTTONS
   ======================================== */

.primary-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;

    padding: 12px 20px;

    background-color: var(--sage-dark);
    color: var(--white);

    border: none;
    border-radius: 12px;

    font-size: 13px;
    font-weight: 700;

    transition:
        background-color 0.2s ease,
        transform 0.2s ease;
}

.primary-btn:hover {
    background-color: #50684F;
}

.primary-btn:active {
    transform: scale(0.97);
}


/* ========================================
   11. DASHBOARD STATISTICS
   ======================================== */

.stats-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;

    margin-bottom: 36px;
}

.stat-card {
    padding: 22px;

    background-color: var(--white);
    border: 1px solid var(--border);
    border-radius: 18px;

    box-shadow: var(--shadow);

    transition: transform 0.2s ease;
}

.stat-card:hover {
    transform: translateY(-3px);
}

.stat-card h3 {
    margin-bottom: 12px;

    color: var(--muted);
    font-size: 12px;
    font-weight: 600;
}

.stat-card .stat-value {
    color: var(--text);
    font-size: 30px;
    font-weight: 700;
    line-height: 1.2;
}

.stat-card p {
    margin-top: 8px;
    color: var(--muted);
    font-size: 11px;
}


/* ========================================
   12. CONTENT SECTIONS
   ======================================== */

.content-section {
    margin-bottom: 36px;
    scroll-margin-top: 24px;
}

.section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;

    margin-bottom: 20px;
}

.section-header h2 {
    color: var(--text);
    font-size: 21px;
    font-weight: 700;
    letter-spacing: -0.4px;
}

.section-header p {
    margin-top: 4px;
    color: var(--muted);
    font-size: 13px;
}


/* ========================================
   13. TASK SECTION
   ======================================== */

.task-section {
    padding: 26px;

    background-color: var(--white);
    border: 1px solid var(--border);
    border-radius: 20px;

    box-shadow: var(--shadow);
}


/* ========================================
   14. TASK FORM
   ======================================== */

#taskForm {
    display: flex;
    gap: 12px;
    margin-bottom: 24px;
}

#taskTitleInput {
    flex: 1;
    min-width: 0;

    padding: 13px 16px;

    color: var(--text);
    background-color: var(--cream);

    border: 1px solid var(--border);
    border-radius: 12px;

    outline: none;
    transition: border-color 0.2s ease;
}

#taskTitleInput::placeholder {
    color: #A6AAA2;
}

#taskTitleInput:focus {
    border-color: var(--sage);
}


/* ========================================
   15. TASK TOOLBAR AND FILTERS
   ======================================== */

.task-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;

    margin-bottom: 20px;
}

.task-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.filter-btn {
    padding: 8px 14px;

    color: var(--muted);
    background-color: transparent;

    border: 1px solid var(--border);
    border-radius: 20px;

    font-size: 12px;

    transition: all 0.2s ease;
}

.filter-btn:hover {
    color: var(--sage-dark);
    border-color: var(--sage);
}

.filter-btn.active {
    color: var(--white);
    background-color: var(--sage-dark);
    border-color: var(--sage-dark);
}


/* ========================================
   16. TASK LIST
   ======================================== */

#taskList {
    display: flex;
    flex-direction: column;
    gap: 10px;

    list-style: none;
}

.task-item {
    display: flex;
    align-items: center;
    gap: 12px;

    padding: 15px;

    background-color: var(--cream);
    border: 1px solid transparent;
    border-radius: 12px;

    transition: border-color 0.2s ease;
}

.task-item:hover {
    border-color: var(--border);
}

.task-checkbox {
    width: 19px;
    height: 19px;

    accent-color: var(--sage-dark);
    flex-shrink: 0;
    cursor: pointer;
}

.task-title {
    flex: 1;
    min-width: 0;

    color: var(--text);
    font-size: 13px;

    overflow-wrap: anywhere;
}

.task-item.completed .task-title {
    color: var(--muted);
    text-decoration: line-through;
}

.task-actions {
    display: flex;
    align-items: center;
    gap: 6px;
}

.task-action-btn {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 32px;
    height: 32px;

    color: var(--muted);
    background-color: transparent;

    border: none;
    border-radius: 8px;
}

.task-action-btn:hover {
    color: var(--sage-dark);
    background-color: var(--sage-light);
}


/* ========================================
   17. EMPTY TASK STATE
   ======================================== */

.empty-state {
    padding: 36px 20px;
    text-align: center;
}

.empty-state .empty-icon {
    margin-bottom: 12px;
    font-size: 36px;
}

.empty-state h3 {
    margin-bottom: 6px;

    color: var(--text);
    font-size: 16px;
}

.empty-state p {
    color: var(--muted);
    font-size: 13px;
}


/* ========================================
   18. FOCUS TIMER CARD
   ======================================== */

.focus-card {
    display: flex;
    flex-direction: column;
    align-items: center;

    padding: 32px 24px;

    background-color: var(--white);
    border: 1px solid var(--border);
    border-radius: 20px;

    box-shadow: var(--shadow);
    text-align: center;
}

.focus-card h3 {
    margin-bottom: 8px;
    color: var(--text);
    font-size: 18px;
}

.focus-card > p {
    margin-bottom: 24px;
    color: var(--muted);
    font-size: 13px;
}


/* ========================================
   19. TIMER CIRCLE
   ======================================== */

.timer-circle {
    width: 200px;
    height: 200px;

    display: flex;
    align-items: center;
    justify-content: center;

    margin: 8px 0 26px;

    background: conic-gradient(
        var(--sage) 0deg,
        var(--sage-light) 0deg
    );

    border-radius: 50%;
}

.timer-inner {
    width: 174px;
    height: 174px;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    background-color: var(--white);
    border-radius: 50%;
}

#timerDisplay {
    color: var(--text);
    font-size: 38px;
    font-weight: 700;
    letter-spacing: -1px;
    line-height: 1.2;
}

.timer-inner p {
    margin-top: 8px;
    color: var(--muted);
    font-size: 11px;
}


/* ========================================
   20. TIMER CONTROLS
   ======================================== */

.timer-controls {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
}

#resetTimer {
    padding: 12px 20px;

    color: var(--sage-dark);
    background-color: var(--sage-light);

    border: none;
    border-radius: 12px;

    font-size: 13px;
    font-weight: 700;
}

#resetTimer:hover {
    background-color: #DCE7D8;
}


/* ========================================
   21. PLACEHOLDER CARDS
   ======================================== */

.placeholder-card {
    padding: 28px;

    background-color: var(--white);
    border: 1px solid var(--border);
    border-radius: 18px;

    box-shadow: var(--shadow);
}

.placeholder-card h3 {
    margin-bottom: 8px;
    color: var(--text);
    font-size: 16px;
}

.placeholder-card p {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.7;
}

.placeholder-icon {
    margin-bottom: 12px;
    font-size: 28px;
}


/* ========================================
   22. PAGE FOOTER
   ======================================== */

.page-footer {
    padding: 24px 0;
    margin-top: 20px;

    color: var(--muted);
    border-top: 1px solid var(--border);

    font-size: 12px;
    text-align: center;
}


/* ========================================
   23. TABLET RESPONSIVENESS
   ======================================== */

@media (max-width: 1100px) {
    .main-content {
        padding: 28px;
    }

    .stats-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}


/* ========================================
   24. SMALL TABLETS
   ======================================== */

@media (max-width: 800px) {
    :root {
        --sidebar-width: 210px;
    }

    .sidebar {
        padding: 24px 14px;
    }

    .main-content {
        padding: 24px;
    }

    .brand {
        gap: 9px;
    }

    .brand-logo {
        width: 36px;
        height: 36px;
    }

    .brand-name {
        font-size: 21px;
    }

    .top-header h1 {
        font-size: 26px;
    }
}


/* ========================================
   25. MOBILE RESPONSIVENESS
   ======================================== */

@media (max-width: 650px) {
    .sidebar {
        position: relative;

        width: 100%;
        height: auto;

        padding: 18px;

        border-right: none;
        border-bottom: 1px solid var(--border);

        overflow: visible;
    }

    .brand {
        margin-bottom: 20px;
    }

    .sidebar-nav {
        flex-direction: row;
        flex-wrap: wrap;
        gap: 8px;
    }

    .nav-heading {
        width: 100%;
        margin-bottom: 4px;
    }

    .nav-link {
        flex: 1 1 auto;
        justify-content: center;
        gap: 6px;

        padding: 9px 10px;
        font-size: 12px;
    }

    .nav-icon {
        width: auto;
        font-size: 16px;
    }

    .motivation-card {
        margin-top: 20px;
        margin-bottom: 16px;
    }

    .profile {
        padding-top: 16px;
    }

    .main-content {
        margin-left: 0;
        padding: 22px 16px;
    }

    .top-header {
        align-items: flex-start;
        flex-direction: column;
        gap: 14px;

        margin-bottom: 24px;
    }

    .top-header h1 {
        font-size: 26px;
    }

    .stats-grid {
        gap: 12px;
        margin-bottom: 28px;
    }

    .stat-card {
        padding: 16px;
    }

    .stat-card .stat-value {
        font-size: 25px;
    }

    .section-header {
        align-items: flex-start;
        flex-direction: column;
        gap: 10px;
    }

    .task-section {
        padding: 18px 14px;
    }

    #taskForm {
        flex-direction: column;
    }

    #taskForm .primary-btn {
        width: 100%;
    }

    .task-toolbar {
        align-items: flex-start;
        flex-direction: column;
    }

    .task-item {
        padding: 12px 10px;
    }

    .task-actions {
        gap: 2px;
    }

    .task-action-btn {
        width: 28px;
        height: 28px;
    }

    .timer-circle {
        width: 180px;
        height: 180px;
    }

    .timer-inner {
        width: 156px;
        height: 156px;
    }

    #timerDisplay {
        font-size: 34px;
    }
}


/* ========================================
   26. EXTRA SMALL MOBILE SCREENS
   ======================================== */

@media (max-width: 380px) {
    .main-content {
        padding: 18px 12px;
    }

    .stats-grid {
        grid-template-columns: 1fr;
    }

    .nav-link {
        flex: 1 1 100%;
        justify-content: flex-start;
    }

    .brand-logo {
        width: 34px;
        height: 34px;
    }

    .brand-name {
        font-size: 20px;
    }
}

/* TASKS PAGE */

.task-form {
    display: flex;
    gap: 12px;
    margin-bottom: 24px;
}

.task-form input {
    flex: 1;
    min-width: 0;
    padding: 13px 16px;
    color: var(--text);
    background-color: var(--cream);
    border: 1px solid var(--border);
    border-radius: 12px;
    outline: none;
}

.task-form input:focus {
    border-color: var(--sage);
}

.task-form input::placeholder {
    color: #A6AAA2;
}

.section-label {
    color: var(--muted);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
}

.welcome-text {
    margin-top: 6px;
    color: var(--muted);
    font-size: 14px;
}

@media (max-width: 650px) {
    .task-form {
        flex-direction: column;
    }

    .task-form .primary-btn {
        width: 100%;
    }
}